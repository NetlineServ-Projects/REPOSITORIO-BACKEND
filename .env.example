# Variáveis SERVICE_*: no Coolify são geradas e guardadas por ele; localmente defina-as aqui.
# Use só letras e números nas palavras-passe da BD (entram no DATABASE_URL sem codificação).
SERVICE_PASSWORD_MYSQLROOT=troque-esta-senha
SERVICE_USER_MYSQL=repositorio_backend_user
SERVICE_PASSWORD_MYSQL=troqueEstaSenhaTambem
MYSQL_DATABASE=repositorio
SERVICE_PASSWORD_64_JWT=defina-um-segredo-forte-aqui
SERVICE_PASSWORD_ADMIN=defina-uma-senha-forte

# Fuso horário dos registos (a BD trabalha sempre em UTC)
TZ=Africa/Maputo

# Porta da API (dentro do contentor é sempre 3000)
PORT=3000
# Portas na máquina local (docker-compose.override.yml, só em desenvolvimento)
HOST_PORT=3000
DB_HOST_PORT=3307

# Só para correr a API fora do Docker (no compose vêm das SERVICE_* acima):
# JWT_SECRET=defina-um-segredo-forte-aqui

# CORS
FRONTEND_URL=http://localhost:5173

# Cookie da sessão (HttpOnly; Secure; SameSite=Strict). Em produção a API tem de estar em
# HTTPS e no mesmo site do frontend. Só "false" num servidor de testes sem HTTPS.
COOKIE_SECURE=true

# Só para correr a API ou o Prisma fora do Docker (o docker-compose define-a sozinho):
# DATABASE_URL=mysql://UTILIZADOR:PALAVRA_PASSE@localhost:3307/NOME_DA_BD

# Criptografia: 64 caracteres hex, gerados com "openssl rand -hex 32".
# Não a mude depois de haver dados: os valores encriptados deixam de poder ser lidos.
ENCRYPTION_KEY=defina-uma-chave-hex-de-64-caracteres

# Utilizador ADMIN criado pelo seed (a palavra-passe é a SERVICE_PASSWORD_ADMIN;
# fora do Docker use ADMIN_SENHA)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
# ADMIN_SENHA=defina-uma-senha-forte
ADMIN_NUMERO=000000000
ADMIN_CARGO=Administrador
ADMIN_DEPARTAMENTO=TI
