generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senha        String
  numero       String   @default("")
  cargo        String   @default("")
  departamento String   @default("")
  perfilId     Int
  perfil       PerfilAcesso @relation(fields: [perfilId], references: [id])
  ativo        Boolean  @default(true)
  fotografia   String? 
  dataCriacao  DateTime @default(now())

  temaEscuro        Boolean @default(false)
  notificacoesEmail Boolean @default(true)
  idioma            String  @default("pt")

  documentos      Documento[]
  atividades      Atividade[]
  sistemasCriados Sistema[]   @relation("CriadorDoSistema")
  notificacoes    Notificacao[]
}

// Perfil de acesso: um conjunto de permissões (ver src/constants/permissoes.js).
// O perfil "administrador" tem tudo e não se pode editar nem apagar.
model PerfilAcesso {
  id            Int       @id @default(autoincrement())
  nome          String    @unique
  descricao     String    @default("")
  administrador Boolean   @default(false)
  permissoes    Json
  dataCriacao   DateTime  @default(now())
  usuarios      Usuario[]
}

model Documento {
  id             Int             @id @default(autoincrement())
  titulo         String
  descricao      String?
  nomeArquivo    String
  caminho        String 
  tipoArquivo    String
  tamanho        BigInt
  estado         EstadoDocumento @default(PENDENTE)
  dataSubmissao  DateTime        @default(now())
  motivoRejeicao String?
  apagadoEm      DateTime?

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

 
  sistemaId Int?
  sistema   Sistema? @relation(fields: [sistemaId], references: [id], onDelete: SetNull)

  atividades   Atividade[]
  notificacoes Notificacao[]
}

model Categoria {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String?
  sensivel  Boolean @default(false)

  documentos Documento[]
}

model Sistema {
  id                        Int           @id @default(autoincrement())
  nome                      String        @db.VarChar(255)
  desenvolvedores           Json
  empresasClientes          Json
  descricaoCurta            String?       @db.VarChar(255)
  descricaoLonga            String?       @db.Text
  dataInicio                DateTime
  dataEntrega               DateTime?
  status                    StatusSistema @default(EM_DESENVOLVIMENTO)
  tecnologiasFrontend       Json?
  tecnologiasBackend        Json?
  tecnologiasInfraestrutura Json?
  repositorioUrl            String?       @db.VarChar(255)
  urlProducao               String?       @db.VarChar(255)
  urlTestes                 String?       @db.VarChar(255)
  responsavelTecnico        String?       @db.VarChar(255)
  versaoAtual               String?       @db.VarChar(50)
  ativo                     Boolean       @default(true)
  documentos                Documento[]
  atividades                Atividade[]
  dataCriacao               DateTime      @default(now())


  infraestruturas SistemaInfraestrutura[]
  subdominios Subdominio[]

  plataformaFrontendId Int?
  plataformaFrontend   Plataforma? @relation("FrontendDoSistema", fields: [plataformaFrontendId], references: [id], onDelete: SetNull)

  // Quem criou o sistema: só essa pessoa (ou um ADMIN) o pode editar e eliminar.
  // Nulo nos sistemas antigos sem registo de criação, e se o utilizador for eliminado.
  criadoPorId Int?
  criadoPor   Usuario? @relation("CriadorDoSistema", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([plataformaFrontendId])
  @@index([criadoPorId])
  @@map("sistemas")
}
    
model Plataforma {
  id         Int            @id @default(autoincrement())
  nome       String         @unique @db.VarChar(255)
  tipo       TipoPlataforma
  fornecedor FornecedorPlataforma
  logotipo   String?        @db.VarChar(255) 
  urlPainel  String?        @db.VarChar(255)
  ativo      Boolean        @default(true)

  // Contas de acesso (utilizador + token): uma plataforma pode ter várias,
  // ex: a conta da Netline e a de um cliente que gerimos
  acessos PlataformaAcesso[]

  // Só para CONTAINERIZACAO
  registryUrl String? @db.Text
  namespace   String?
  imagens     ImagemContainer[]

  dominios        Dominio[]
  servidores      Servidor[]
  // Sistemas ligados diretamente à plataforma, sem servidor (ex: Vercel)
  infraestruturas SistemaInfraestrutura[]
  // Sistemas cujo frontend está hospedado nesta plataforma (ex: Vercel)
  sistemasFrontend Sistema[] @relation("FrontendDoSistema")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("plataformas")
}

model PlataformaAcesso {
  id           Int     @id @default(autoincrement())
  // Para distinguir as contas, ex: "Conta da Netline", "Cliente X"
  descricao    String? @db.VarChar(255)
  utilizador   String? @db.VarChar(255)
  tokenCifrado String? @db.Text // AES-256-GCM

  plataformaId Int
  plataforma   Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Cascade)
  dominios     Dominio[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([plataformaId])
  @@map("plataforma_acessos")
}

model Dominio {
  id            Int      @id @default(autoincrement())
  nome          String   @unique @db.VarChar(255) // ex: empresa.co.mz
  dataExpiracao DateTime

  plataformaId Int
  plataforma   Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Restrict)
  // Conta da plataforma (instituição) onde o domínio está registado, ex: Netline ou um cliente
  acessoId     Int?
  acesso       PlataformaAcesso? @relation(fields: [acessoId], references: [id], onDelete: SetNull)
  subdominios Subdominio[]
  notificacoes Notificacao[]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([plataformaId])
  @@index([acessoId])
  @@map("dominios")
}

// A / AAAA → servidorId preenchido | CNAME e os restantes → destino preenchido (validado na API)
model Subdominio {
  id      Int     @id @default(autoincrement())
  nome    String  @db.VarChar(255) // só o prefixo, ex: "app"
  tipoDns TipoDns @default(A)
  destino String? @db.Text

  dominioId Int
  dominio   Dominio @relation(fields: [dominioId], references: [id], onDelete: Restrict)

  servidorId Int?
  servidor   Servidor? @relation(fields: [servidorId], references: [id], onDelete: SetNull)

  // Endereço público do sistema num ambiente: há um por sistema e ambiente
  sistemaId Int
  sistema   Sistema      @relation(fields: [sistemaId], references: [id], onDelete: Cascade)
  ambiente  TipoAmbiente

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // O mesmo nome pode ter vários tipos (ex: "@" com MX, TXT e NS),
  // mas não o mesmo tipo repetido
  @@unique([dominioId, nome, tipoDns])
  @@unique([sistemaId, ambiente])
  @@index([dominioId])
  @@index([servidorId])
  @@map("subdominios")
}

model Servidor {
  id                  Int                  @id @default(autoincrement())
  nome                String               @db.VarChar(255)
  hostname            String               @db.VarChar(255)
  ipCifrado           String               @db.Text // AES-256-GCM
  ipHash              String               @db.VarChar(64) // HMAC-SHA256, só para unicidade
  usernameSsh         String               @db.VarChar(255)
  passwordCifrada     String               @db.Text // AES-256-GCM; nunca devolvida na árvore
  numeroCpu           Int
  memoriaRam          Int
  memoriaRamUnidade   UnidadeArmazenamento @default(GB)
  disco               Int
  discoUnidade        UnidadeArmazenamento @default(GB)
  larguraBanda        Int
  larguraBandaUnidade UnidadeVelocidade    @default(MBPS)
  sistemaOperativo    String               @db.VarChar(100)
  versaoSo            String?              @db.VarChar(50)
  cloud               String?              @db.VarChar(255)
  regiao              String?              @db.VarChar(100)
  estado EstadoServidor @default(INATIVO)

  plataformaId Int
  plataforma   Plataforma @relation(fields: [plataformaId], references: [id], onDelete: Restrict)

  subdominios     Subdominio[]
  infraestruturas SistemaInfraestrutura[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([plataformaId, ipHash])
  @@index([plataformaId])
  @@map("servidores")
}

model ImagemContainer {
  id           Int                @id @default(autoincrement())
  nome         String
  tag          String             @default("latest")
  portaExposta Int?
  digest       String?
  ultimoPushEm DateTime?
  visibilidade VisibilidadeImagem @default(PRIVADA)
  origem       OrigemImagem       @default(PROPRIA)
  ativo        Boolean            @default(true)
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt

  plataformaId Int
  plataforma   Plataforma         @relation(fields: [plataformaId], references: [id], onDelete: Cascade)
  
  infraestruturas SistemaInfraestrutura[]
  @@unique([plataformaId, nome, tag])
}

model SistemaInfraestrutura {
  id        Int     @id @default(autoincrement())
  sistemaId Int
  sistema   Sistema @relation(fields: [sistemaId], references: [id], onDelete: Cascade)

  ambiente TipoAmbiente @default(PRODUCAO)

  plataformaId Int?
  plataforma   Plataforma?      @relation(fields: [plataformaId], references: [id], onDelete: SetNull)
  servidorId   Int?
  servidor     Servidor?        @relation(fields: [servidorId], references: [id], onDelete: SetNull)
  imagemId     Int?
  imagem       ImagemContainer? @relation(fields: [imagemId], references: [id], onDelete: SetNull)

  url String? @db.VarChar(255) // endereço do backend neste ambiente, quando não há subdomínio

  ipServidor    String? @db.Text // valor encriptado (AES-256-GCM)
  cloudProvedor String? @db.Text // valor encriptado (AES-256-GCM)

  credenciais CredencialSistema[]


  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Um sistema só pode ter UMA infraestrutura por ambiente
  @@unique([sistemaId, ambiente])
  @@index([servidorId])
  @@index([plataformaId])
  @@index([imagemId])
}

model CredencialSistema {
  id                      Int                   @id @default(autoincrement())
  sistemaInfraestruturaId Int
  sistemaInfraestrutura   SistemaInfraestrutura @relation(fields: [sistemaInfraestruturaId], references: [id], onDelete: Cascade)

  tipo            TipoCredencial
  label           String
  valorEncriptado String         @db.Text // conteúdo encriptado (AES-256-GCM)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Atividade {
  id       String   @id @default(uuid())
  acao     String
  criadoEm DateTime @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  documentoId Int? // opcional — nem toda ação envolve um documento (ex: criação de utilizador)
  documento   Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  sistemaId Int?
  sistema   Sistema? @relation(fields: [sistemaId], references: [id], onDelete: SetNull)
}

// Uma linha por destinatário. O texto mostrado monta-se no frontend a partir do tipo
// (assim segue o idioma de quem lê); "referencia" guarda o título do documento ou o
// nome do domínio, para a notificação continuar legível se esse registo for apagado.
model Notificacao {
  id         Int             @id @default(autoincrement())
  tipo       TipoNotificacao
  referencia String          @db.VarChar(255)
  mensagem   String?         @db.Text // motivo da rejeição
  dataLimite DateTime?       // data de expiração do domínio
  lida       Boolean         @default(false)
  criadoEm   DateTime        @default(now())

  // Só nos avisos de domínio: impede repetir o mesmo aviso para a mesma data de expiração
  chave String? @db.VarChar(100)

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  documentoId Int?
  documento   Documento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  dominioId Int?
  dominio   Dominio? @relation(fields: [dominioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
  @@index([usuarioId, lida])
  @@index([documentoId])
  @@index([dominioId])
  @@map("notificacoes")
}

enum TipoNotificacao {
  DOCUMENTO_SUBMETIDO // para os ADMIN
  DOCUMENTO_APROVADO  // para quem submeteu
  DOCUMENTO_REJEITADO // para quem submeteu, com o motivo
  DOMINIO_A_EXPIRAR   // para os ADMIN
  DOMINIO_EXPIRADO    // para os ADMIN
}

enum EstadoDocumento {
  PENDENTE
  APROVADO
  REJEITADO
}

enum StatusSistema {
  EM_PRODUCAO        @map("Em Produção")
  EM_DESENVOLVIMENTO @map("Em Desenvolvimento")
  MANUTENCAO         @map("Manutenção")
}

enum TipoAmbiente {
  PRODUCAO
  TESTES
}

enum TipoCredencial {
  ENV_VARIAVEIS
  CREDENCIAIS_BD
  CHAVE_TOKEN_API
  CHAVE_SSH
  CERTIFICADO_SSL
  CREDENCIAIS_DNS
  ACESSO_CONSOLA_CLOUD
  CREDENCIAIS_CICD
  CONFIGURACAO_VPN_FIREWALL
  CREDENCIAIS_SMTP
  BACKUP_ACESSO
  OUTRO
}

enum TipoPlataforma {
  CLOUD_BASE_DADOS
  CONTAINERIZACAO
  GESTAO_DOMINIO
}

enum TipoDns {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
  PTR
  SOA
  DS
  DNSKEY
  RRSIG
  TLSA
  SSHFP
  OUTRO
}

enum FornecedorPlataforma {
  // Containerização
  DOCKER_HUB
  GITHUB_CONTAINER_REGISTRY
  AWS_ECR
  GOOGLE_ARTIFACT_REGISTRY
  AZURE_CONTAINER_REGISTRY
  GITLAB_REGISTRY
  KUBERNETES
  DOCKER_SWARM
  PORTAINER

  // Cloud / Base de Dados
  AWS
  MICROSOFT_AZURE
  GOOGLE_CLOUD
  ORACLE_CLOUD
  DIGITALOCEAN
  HETZNER_CLOUD
  LINODE
  VULTR
  OVHCLOUD
  CONTABO
  VERCEL
  NETLIFY
  RAILWAY
  RENDER
  FLY_IO
  HEROKU
  SUPABASE
  PLANETSCALE
  MONGODB_ATLAS
  NEON
  AIVEN
  FIREBASE

  // Gestão de Domínio e DNS
  CLOUDFLARE
  GODADDY
  NAMECHEAP
  GANDI
  PORKBUN
  HOSTINGER
  SQUARESPACE_DOMAINS
  AWS_ROUTE_53
  AZURE_DNS
  GOOGLE_CLOUD_DNS
  CPANEL
  AGENTE_REGISTO_MZ

  // Qualquer tipo
  OUTRO
}

enum VisibilidadeImagem {
  PUBLICA
  PRIVADA
}

enum OrigemImagem {
  PROPRIA
  TERCEIROS
}

// RAM e disco
enum UnidadeArmazenamento {
  MB
  GB
  TB
}

// Largura de banda (velocidade da ligação, em bits por segundo)
enum UnidadeVelocidade {
  MBPS
  GBPS
}

enum EstadoServidor {
  ATIVO
  INATIVO
}
// Auditoria: um registo por pedido à API (quem, quando, o quê, onde e com que resultado).
// Só os administradores a veem. Sem ligação ao utilizador por chave estrangeira: o registo
// fica mesmo que a conta seja apagada, com o nome, e-mail e perfil copiados na altura.
model RegistoAuditoria {
  id            Int      @id @default(autoincrement())
  criadoEm      DateTime @default(now())

  usuarioId     Int?
  usuarioNome   String?  @db.VarChar(255)
  usuarioEmail  String?  @db.VarChar(255)
  perfilNome    String?  @db.VarChar(255)

  // ENTRADA, SAIDA, LOGIN_FALHADO, CONSULTA, CRIACAO, ALTERACAO, ELIMINACAO,
  // ACESSO_SENSIVEL (revelar um segredo), ACESSO_RECUSADO (401/403), ERRO (5xx)
  acao          String   @db.VarChar(30)
  funcionalidade String? @db.VarChar(100) // ex: plataformas, documentos
  recursoId     String?  @db.VarChar(100) // ex: o id do documento
  metodo        String   @db.VarChar(10)
  caminho       String   @db.VarChar(1000)
  estado        Int      // código HTTP da resposta
  duracaoMs     Int
  ip            String?  @db.VarChar(64)
  userAgent     String?  @db.VarChar(500)
  // Corpo e parâmetros do pedido, sem palavras-passe, tokens nem outros segredos
  detalhes      Json?

  @@index([criadoEm])
  @@index([usuarioId])
  @@index([acao])
  @@index([funcionalidade])
  @@map("auditoria")
}
